# --- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=            # temporary access token (24h) or permanent system-user token
PHONE_NUMBER_ID=           # "Phone number ID" of the test number (not the phone number itself)
VERIFY_TOKEN=sakha-verify  # any string you choose; must match what you enter in Meta webhook config
GRAPH_VERSION=v23.0

# --- Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low          # low keeps voice replies snappy; raise to medium/high if replies feel shallow

# --- Sarvam AI (dashboard.sarvam.ai) ---
# The same key does the hearing AND the speaking, on WhatsApp and on a call.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_SPEAKER=karun   # calm male voice; try "anushka"/"vidya" for female
SARVAM_TTS_PACE=1.0        # Normal speed, chosen by LISTENING. 0.9 was picked by
                           # reasoning ("elders need slow") and sounded dull —
                           # clarity is bought back with the pause BETWEEN
                           # sentences instead (VOICE_SENTENCE_PAUSE_MS).
SARVAM_TTS_PITCH=0         # karun's own pitch. -0.2/-0.4/-0.6 were all tried and
                           # every one sounded tired rather than warm. Deep plus
                           # slow is how you get a voice nobody rings back.
                           # Range ~-0.75..0.75. Used by BOTH WhatsApp and calls —
                           # keep them equal or Sakha becomes two different men.

# --- Phone calls from the browser (/m) ---
# Nothing here is required. With no keys at all the page still runs a whole call
# in demo mode; with the three keys above it is live. Deepgram/ElevenLabs are
# deliberately NOT used: Deepgram's Aura has no Hindi voice at all, and Sarvam
# beats both on Hindi prosody and Hinglish, which is all this product speaks.
# VOICE_MODEL=claude-sonnet-5      # the call brain. Latency-bound, so not Opus like
                                   # WhatsApp. claude-haiku-4-5 is faster and flatter.
# VOICE_REVIEW_MODEL=claude-haiku-4-5  # reads the finished call for facts + risk
# SARVAM_STT_LANGUAGE=hi-IN        # the streaming socket needs a concrete language;
                                   # unlike the batch API it will not auto-detect
# SARVAM_STT_HIGH_VAD=false        # true ends turns sooner. Wrong for elders, who
                                   # pause mid-sentence to find a word or to cry
# SARVAM_TTS_MODEL=bulbul:v2
# VOICE_SENTENCE_PAUSE_MS=420      # the pause left at a full stop, in the audio itself
# VOICE_BARGE_IN_MIN_WORDS=2       # words needed to interrupt Sakha mid-reply
# VOICE_MAX_CALL_MS=900000         # hard cap per call, so a stuck socket cannot bill overnight
# VOICE_RELAY_MODE=agent           # "echo" bounces your own voice back: proves the
                                   # transport with no AI in the path at all
# VOICE_CHECK_PORT=3099            # the spare port `npm run voice:check` boots on

PORT=3000
